# Where the BROWSER calls the API. It must be reachable from the browser, so `http://api:4000`
# (which resolves only inside the compose network) will not do.
#
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time, which makes a built image
# environment-specific: pointing it at a different API is a rebuild, not a restart. Nothing
# secret can go in a NEXT_PUBLIC_ variable — every one of them ships to every browser.
#
# In production the panel must be served from the same registrable domain as the API, or the
# SameSite=Strict refresh cookie is never sent and login silently never completes. See
# docs/engineering/build-and-deploy.md.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# The zone editor's map and its address search.
#
# Unlike the URL above, this one is BILLABLE. It is inlined into the client bundle and therefore
# public — unavoidable, because it authenticates a script the browser loads — so it is protected
# by restriction, not by secrecy. Before using a key anywhere real, set BOTH:
#   • an HTTP referrer restriction limiting it to the panel's own domain, and
#   • an API restriction to Maps JavaScript API + Places API only.
#
# "Public in a bundle" is not the same as "public in a repo": scrapers watch GitHub for AIza…
# strings and an unrestricted key gets used until the quota runs out. Real values go in
# apps/web/.env, which is gitignored. THIS FILE IS COMMITTED — keep it a placeholder.
#
# Leave it unset and the zone editor shows a setup notice instead of a map; the rest of the
# screen still works. Because it is inlined at build time, changing it needs a rebuild.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
