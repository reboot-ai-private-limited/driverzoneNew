# Where the app calls the API. EXPO_PUBLIC_* is inlined into the JS bundle at build time, so
# nothing secret can go here — the same rule as NEXT_PUBLIC_* in apps/web.
#
# On a USB-attached Android device, `localhost` is the PHONE, not your machine. Either run
# `adb reverse tcp:4000 tcp:4000` and keep the value below, or put your machine's LAN IP here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api

# ── Google Maps keys — read by app.config.ts for NATIVE BUILDS ONLY ─────────────────────────
#
# NOT EXPO_PUBLIC_*: they are written into the native manifest/Info.plist, not read by JS.
# Expo Go ignores them and uses its own key. Needed only for a dev-client or store build.
#
# Generate in the Google Cloud console (https://console.cloud.google.com):
#   1. APIs & Services → Library → enable "Maps SDK for Android" AND "Maps SDK for iOS".
#   2. APIs & Services → Credentials → Create credentials → API key.  Make TWO keys.
#   3. On the Android key:
#        Application restrictions → Android apps →
#          package name: in.driverzone.customer
#          SHA-1: run  `cd apps/customer/android && ./gradlew signingReport`  (or, for the
#                 upload key, `keytool -list -v -keystore <your.keystore>`), copy the SHA1 line.
#          Add BOTH the debug SHA-1 and your release/upload SHA-1.
#        API restrictions → restrict to "Maps SDK for Android" only.
#   4. On the iOS key:
#        Application restrictions → iOS apps → bundle id: in.driverzone.customer
#        API restrictions → restrict to "Maps SDK for iOS" only.
#
# They must be SEPARATE keys — from each other and from apps/web's NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
# (a Google key accepts only one application-restriction type).
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# ── Google Places key — search type-ahead (src/features/location/placeSearch.ts) ────────────
#
# LEAVE IT BLANK AND SEARCH STILL WORKS: it falls back to the device geocoder, which matches a
# whole typed address and returns one result. What the key buys is real suggestions-as-you-type —
# landmarks, POIs, partial words — which is what customers expect of a destination field.
#
# This one IS `EXPO_PUBLIC_*` (unlike the two Maps keys above): it is called from JS at runtime,
# not written into the native manifest. That means it ships readable inside the bundle — a fourth
# key, restricted separately, never one of the Maps keys reused.
#
#   1. APIs & Services → Library → enable "Places API (New)".
#   2. Credentials → Create credentials → API key.
#   3. API restrictions → restrict to "Places API (New)" only.
#      Application restrictions: Android apps + iOS apps CANNOT both be set on one key, and a
#      bundled key called over HTTPS from the app has no referrer — so either accept an
#      unrestricted-but-API-limited key, or make one per platform and select at build time.
#   4. Set a daily quota cap on it. It is public; the cap is what bounds the damage.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# ── iOS push environment ────────────────────────────────────────────────────────────────────
#
# Which APNs gateway the iOS build is entitled to. Leave unset for local `expo run:ios`.
#
# SET THIS TO `production` FOR ANY BUILD THAT LEAVES YOUR MACHINE (TestFlight, App Store). A
# build entitled `development` uploaded to TestFlight receives NO push at all — Apple routes it
# through the production gateway, and nothing errors: notifications just never arrive, which
# looks exactly like a server that never sent them.
# IOS_APS_ENVIRONMENT=production
