{
  "name": "@driverzone/driver",
  "private": true,
  "version": "0.1.0",
  "main": "index.js",
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-blur",
        "expo-crypto",
        "expo-linear-gradient"
      ]
    }
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
