# ─────────────────────────────────────────────────────────────────────────────
# node-linker=hoisted — required by the two React Native apps, not a preference.
#
# pnpm's default `isolated` linker builds node_modules out of symlinks into a
# content-addressed store. Metro (React Native's bundler) resolves modules by walking
# real directories and does not follow those symlinks, so `@driverzone/contracts`
# resolves to nothing and the app fails at bundle time with an unhelpful
# "Unable to resolve module" — see docs/engineering/08-mobile-in-monorepo.md.
#
# `hoisted` produces an npm-style flat tree that Metro can walk. The cost is losing
# pnpm's protection against phantom dependencies (importing a package you did not
# declare), which is why `lint` runs depcruise's `not-to-unresolvable` rule — that
# catches the same class of mistake at a different point.
node-linker=hoisted

# A deploy must fail loudly on a stale lockfile rather than quietly resolving versions
# that were never tested. CI sets this too; having it here keeps local installs honest.
strict-peer-dependencies=false
auto-install-peers=true
