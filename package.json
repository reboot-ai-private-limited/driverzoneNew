{
  "name": "driverzone",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo run dev",

    "dev:api": "turbo run dev --filter=@driverzone/api",
    "dev:worker": "turbo run dev:worker --filter=@driverzone/api",
    "dev:backend": "turbo run dev dev:worker --filter=@driverzone/api",
    "dev:web": "turbo run dev --filter=@driverzone/api --filter=@driverzone/web",
    "dev:full": "turbo run dev dev:worker --filter=@driverzone/api --filter=@driverzone/web",
    "dev:customer": "pnpm --filter @driverzone/customer dev",
    "dev:driver": "pnpm --filter @driverzone/driver dev",

    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck lint test",
    "ci": "turbo run typecheck lint test build --filter='...[origin/main]'",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md}\""
  },
  "devDependencies": {
    "@driverzone/config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
