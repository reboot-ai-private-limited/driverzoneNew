{
  "expo": {
    "name": "DriverZone",
    "slug": "driverzone-customer",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "driverzone",
    "experiments": {
      "reactCompiler": true
    },
    "backgroundColor": "#F2F200",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F2F200"
        }
      ],
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DriverZone uses your location to set your pickup point and to check whether we have drivers in your area.",
          "locationAlwaysAndWhenInUsePermission": "DriverZone only uses your location while the app is open, to set your pickup point and check driver coverage. It never tracks you in the background.",
          "isIosBackgroundLocationEnabled": false,
          "locationAlwaysPermission": "DriverZone only uses your location while the app is open, to set your pickup point and check driver coverage. It never tracks you in the background."
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withUpiQueries.js",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": false,
          "photosPermission": "DriverZone uses your photo library only when you choose a profile picture."
        }
      ],
      "./plugins/withStripPermissions.js",
      "./plugins/withHighRefreshRate.js",
      "./plugins/withNotificationIcon.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "android": {
      "package": "in.driverzone.customer",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2F200"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "ios": {
      "bundleIdentifier": "in.driverzone.customer",
      "buildNumber": "1",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tez",
          "gpay",
          "phonepe",
          "paytmmp",
          "bhim",
          "upi",
          "credpay",
          "mobikwik",
          "freecharge",
          "amazonpay"
        ]
      }
    }
  }
}
