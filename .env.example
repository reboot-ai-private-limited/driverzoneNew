# ─────────────────────────────────────────────────────────────────────────────
# Repo-root .env — BUILD-time values for the production web image.
#
# Compose reads this file's real counterpart (`.env`, gitignored) automatically for ${...}
# interpolation in docker-compose.prod.yml. Nothing here is injected into a running container:
# these are passed to `docker build` as args, because `next build` INLINES every NEXT_PUBLIC_*
# into the client bundle. Changing one is therefore a rebuild, not a restart:
#
#   docker compose -f docker-compose.prod.yml up -d --build web
#
# Runtime configuration lives elsewhere — apps/api/.env.prod for the API and worker,
# apps/web/.env.prod for the web server. See docs/engineering/build-and-deploy.md.
#
#   cp .env.example .env    then edit
# ─────────────────────────────────────────────────────────────────────────────

# Where the BROWSER calls the API, so it must be reachable from the browser: the deployment's
# public host, not `localhost` and not `http://api:4000` (which resolves only inside the compose
# network). Required — the build fails without it rather than shipping the localhost fallback.
NEXT_PUBLIC_API_BASE_URL=http://your-vm-ip:4000/api

# The zone editor's map and address search. Optional: leave it empty and the editor shows a setup
# notice while the rest of the screen works.
#
# BILLABLE and PUBLIC — it ships in the bundle to every browser, unavoidably, because it
# authenticates a script the browser loads. It is protected by restriction, not secrecy. Before
# using a real key set BOTH an HTTP referrer restriction limiting it to the panel's own domain and
# an API restriction to Maps JavaScript API + Places API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# The public marketing site's own canonical URL (apps/site), used for og:url and metadata.
# Required — the site image refuses to build without it rather than advertising localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
