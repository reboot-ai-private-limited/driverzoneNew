NODE_ENV=development
PORT=4000

# The compose dev stack runs a single-node replica set. Without these two parameters the driver
# connects in "single" topology mode: ordinary reads and writes work, and the first
# multi-document transaction (the booking→ledger write, docs/LLD/pricing-and-commission.md) fails with
# "Transaction numbers are only allowed on a replica set member or mongos".
MONGO_URI=mongodb://localhost:27017/driverzone?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# If a Mongo or Redis is already running on the host, start the dev stack on other ports —
# MONGO_PORT=27018 REDIS_PORT=6380 docker compose -f docker-compose.dev.yml up -d — and match
# them in the two URLs above.

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# Self-hosted OSRM. Road distance is required to match outstation bands (docs/LLD/zone-resolution.md).
OSRM_BASE_URL=http://localhost:5000

# Token signing secrets — SEPARATE by design (docs/decision-log.md, 2026-08-24): a leaked access
# secret must not also forge refresh tokens. Minimum 32 characters, enforced at boot.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48-output-value
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-openssl-rand-base64-48-value

# Keys the HMAC that login OTPs are stored under (docs/LLD/auth.md §OTP).
OTP_PEPPER=replace-me-with-another-openssl-rand-base64-48-value

# DEVELOPMENT ONLY. A fixed OTP accepted for the four accounts `pnpm seed` creates, so logging in
# locally does not mean reading a code off the API log on every attempt. Any other number still
# gets a real random code. The process REFUSES TO START if this is set with NODE_ENV=production.
# DEV_FIXED_OTP=000000

# Cloudinary credentials for media storage
# Signs the payment gateway's webhooks. The mock gateway signs with it too, so the signature path
# is exercised locally rather than discovered broken against a real provider. The webhook is an
# unauthenticated public endpoint that CONFIRMS BOOKINGS, so this has the same 32-character floor
# as the token secrets: openssl rand -base64 48
PAYMENT_WEBHOOK_SECRET=replace-me-with-another-openssl-rand-base64-48-value

# Whether the mock gateway captures immediately. `false` exercises the pending-then-webhook path.
MOCK_PAYMENT_AUTO_CAPTURE=true

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Upload constraints
UPLOAD_MAX_FILE_SIZE_MB=3
UPLOAD_ALLOWED_FORMATS=jpg,png,webp
