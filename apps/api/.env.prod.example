# Runtime environment for the Docker stack in docker-compose.prod.yml.
#
#   cp apps/api/.env.prod.example apps/api/.env.prod
#
# Kept separate from .env — that one holds the localhost URIs the host-run dev API uses, and
# loading it into a production image would set NODE_ENV=development and point CORS at
# localhost. Never commit the filled-in .env.prod: it reaches containers through compose
# `env_file` at RUN time, never through an image layer.

NODE_ENV=production
PORT=4000

LOG_LEVEL=info

# Origins allowed to call the API from a browser. Comma-separated, no trailing slash. This is
# where the admin panel is served from — the value below matches the local prod stack; a real
# deployment uses its own hostname, e.g. https://admin.driverzone.example.
CORS_ORIGINS=http://localhost:3000

# MONGO_URI, REDIS_URL and OSRM_BASE_URL are NOT set here. docker-compose.prod.yml sets them
# to compose service names after loading this file, so anything written here is overridden.
# Point the API at an external database by editing the `environment:` block in that file.

# ── Required Secrets ─────────────────────────────────────────────────────────────────────────
# Generate 48-character random strings for these using: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48-output-value
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-openssl-rand-base64-48-value
OTP_PEPPER=replace-me-with-another-openssl-rand-base64-48-value
PAYMENT_WEBHOOK_SECRET=replace-me-with-another-openssl-rand-base64-48-value

# Cloudinary credentials for media storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (Optional - if missing, API fails on boot in production because mock gateway is disabled)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# WhatsApp OTP delivery via wabridge.com. Set all four and login codes go over WhatsApp; leave
# any unset and the code is written to the log — which LoggingOtpSender then REFUSES in a
# NODE_ENV=production process, so a real deploy that forgot these fails to boot rather than
# printing codes to stdout. WA_TEMPLATE_ID must be an APPROVED template whose one {{1}} variable
# is the code.
WA_API_URL=https://web.wabridge.com/api/createmessage
WA_APP_KEY=replace_me
WA_AUTH_KEY=replace_me
WA_DEVICE_ID=replace_me
WA_TEMPLATE_ID=replace_me

# ── STAGING ONLY — leave both commented out for any real deployment ──────────────────────────
# A staging host is a production BUILD with no SMS provider, which means nobody can log into it:
# the only OTP "sender" writes the code to the log and refuses to run in production. These two
# together are the way in, and they are deliberately one decision rather than two.
#
# STAGING_UNSAFE opens four guards at once:
#   • DEV_FIXED_OTP is accepted in production instead of killing the process at boot
#   • the seeded accounts in src/config/devAccounts.ts accept that fixed code
#   • login codes are written to this host's logs rather than sent by SMS
#   • the seed script runs (docker compose run --rm seed), creating those accounts
#
# The seeded phone numbers and the conventional code 000000 are BOTH committed to this
# repository, so a host with these set can be logged into as an administrator by anyone who has
# read it. Correct for a throwaway staging VM holding no real data. Never anywhere else. The API
# prints a warning block on every boot while they are set.
# STAGING_UNSAFE=true
# DEV_FIXED_OTP=000000
