# Where the app calls the API. EXPO_PUBLIC_* is inlined into the JS bundle at build time, so
# nothing secret can go here — the same rule as NEXT_PUBLIC_* in apps/web.
#
# On a USB-attached Android device, `localhost` is the PHONE, not your machine. Either run
# `adb reverse tcp:4000 tcp:4000` and keep the value below, or put your machine's LAN IP here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api

# The Google Maps key for NATIVE ANDROID BUILDS, read by app.config.ts and written into the
# generated AndroidManifest. Not EXPO_PUBLIC_* — it is not read by JavaScript at runtime.
#
# Needed only for a development or store build. Expo Go supplies its own key and ignores this
# one entirely.
#
# It must be a SEPARATE key from apps/web's NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: a Google key takes
# only one application-restriction type, so the panel's HTTP-referrer restriction and an Android
# package restriction cannot live on the same key. Restrict this one to package
# `in.driverzone.customer` + the signing SHA-1, and to the Maps SDK for Android alone.
GOOGLE_MAPS_ANDROID_API_KEY=
