# Where the app calls the API. EXPO_PUBLIC_* is inlined into the JS bundle at build time, so
# nothing secret can go here — the same rule as NEXT_PUBLIC_* in apps/web.
#
# On a USB-attached Android device, `localhost` is the PHONE, not your machine. Either run
# `adb reverse tcp:4000 tcp:4000` and keep the value below, or put your machine's LAN IP here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
