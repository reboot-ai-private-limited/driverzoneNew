node_modules/
.pnpm-store/

dist/
build/
.next/
out/
*.tsbuildinfo
.turbo/

.env
.env.*
!.env.example
!**/.env.example
# Per-environment templates, e.g. .env.prod.example. The two rules above un-ignore only the
# exact name `.env.example`, so `.env.*` would otherwise swallow every other template.
!.env.*.example
!**/.env.*.example

coverage/


.expo/
*.apk
*.aab
*.ipa

.DS_Store
*.log

# Generated by `expo prebuild` (CNG). Regenerate rather than commit — see
# docs/engineering/mobile-in-monorepo.md.
apps/*/android/
apps/*/ios/
apps/api/firebaseServiceAccount.json
apps/api/**/firebase*serviceaccount*.json
apps/api/secrets/

# Local tokens — never commit
drvtok.txt
*.token.txt
