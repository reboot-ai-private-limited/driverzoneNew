{
  "name": "@driverzone/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc --noEmit && node esbuild.config.mjs",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src --ext .ts && pnpm lint:deps",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@driverzone/contracts": "workspace:*",
    "@driverzone/geo": "workspace:*",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^6.2.10",
    "mongoose": "^8.9.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "uuid": "^14.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@driverzone/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "dependency-cruiser": "^16.9.0",
    "esbuild": "^0.24.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
