# Runtime environment for the Docker stack in docker-compose.prod.yml.
#
#   cp apps/api/.env.prod.example apps/api/.env.prod
#
# Kept separate from .env — that one holds the localhost URIs the host-run dev API uses, and
# loading it into a production image would set NODE_ENV=development and point CORS at
# localhost. Never commit the filled-in .env.prod: it reaches containers through compose
# `env_file` at RUN time, never through an image layer.

NODE_ENV=production
PORT=4000

LOG_LEVEL=info

# Origins allowed to call the API from a browser. Comma-separated, no trailing slash. This is
# where the admin panel is served from — the value below matches the local prod stack; a real
# deployment uses its own hostname, e.g. https://admin.driverzone.example.
CORS_ORIGINS=http://localhost:3000

# MONGO_URI, REDIS_URL and OSRM_BASE_URL are NOT set here. docker-compose.prod.yml sets them
# to compose service names after loading this file, so anything written here is overridden.
# Point the API at an external database by editing the `environment:` block in that file.
