# Copy to `apps/driver/.env`. Everything here is inlined into the JS bundle at build time
# (EXPO_PUBLIC_*), exactly like NEXT_PUBLIC_* in apps/web — so nothing secret belongs in this file.

# Where the app calls the API.
#
# `localhost` works in an Android emulator via 10.0.2.2, but on a PHYSICAL phone running Expo Go
# `localhost` is the phone itself, not your machine — the app will simply fail to reach the API
# with no useful error. Use your machine's LAN address:
#
#   Windows:  ipconfig      → "IPv4 Address" on your Wi-Fi adapter
#   macOS:    ipconfig getifaddr en0
#
# Both the phone and your machine must be on the same Wi-Fi.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api
